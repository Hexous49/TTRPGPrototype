<form class="{{cssClass}} myttrpg-actor-sheet" autocomplete="off">

  {{!-- Header --}}
  <header class="myttrpg-sheet-header">
    <img class="myttrpg-actor-portrait" src="{{actor.img}}" data-edit="img" title="{{actor.name}}">
    <h1><input name="name" type="text" value="{{actor.name}}" placeholder="Name"></h1>
  </header>

  {{!-- Health Pools --}}
  <section class="myttrpg-section">
    <h2>{{labels.sectionHealth}}</h2>

    <div class="myttrpg-pool">
      <span class="pool-label">{{labels.vitality}}</span>
      <input type="number" name="system.vitality.value" value="{{system.vitality.value}}" min="0">
      <span class="pool-sep">/</span>
      <span class="pool-max">{{system.vitality.max}}</span>
      <button type="button" class="myttrpg-btn-icon edit-pool" data-type="vitality" title="{{labels.editPool}}">&#9998;</button>
      <span class="pool-btn-spacer"></span>
    </div>

    {{#each system.pools}}
    <div class="myttrpg-pool">
      <span class="pool-label">{{name}}</span>
      <input type="number" name="system.pools.{{@index}}.value" value="{{value}}" min="0">
      <span class="pool-sep">/</span>
      <span class="pool-max">{{max}}</span>
      <button type="button" class="myttrpg-btn-icon edit-pool" data-index="{{@index}}" title="{{../labels.editPool}}">&#9998;</button>
      <button type="button" class="myttrpg-btn-icon remove-pool" data-index="{{@index}}" title="{{../labels.removePool}}">&#x2715;</button>
    </div>
    {{/each}}

    {{!-- Total: sum of vitality + all pools --}}
    <div class="myttrpg-pool myttrpg-pool-total">
      <span class="pool-label">{{labels.totalHealth}}</span>
      <span class="pool-total-value">{{system.totalHealth.value}}</span>
      <span class="pool-sep">/</span>
      <span class="pool-max">{{system.totalHealth.max}}</span>
      <span class="pool-btn-spacer"></span>
      <span class="pool-btn-spacer"></span>
    </div>

    <button type="button" class="myttrpg-btn add-pool">{{labels.addPool}}</button>
  </section>

  {{!-- Character-only sections --}}
  {{#if isCharacter}}

  {{!-- Equipment --}}
  <section class="myttrpg-section">
    <h2>{{labels.sectionEquipment}}</h2>

    {{!-- Weapon slot --}}
    <div class="myttrpg-equipment-slot{{#if system.equippedWeapon}} equipped{{/if}}">
      <span class="slot-label">{{labels.weaponSlot}}</span>
      {{#if system.equippedWeapon}}
        <span class="slot-item-name">{{system.equippedWeapon.name}}</span>
        <span class="slot-weapon-stats">{{system.equippedWeapon.damage}} · {{system.equippedWeapon.range}}</span>
        <button type="button" class="myttrpg-btn-icon stow-btn" data-slot="equippedWeaponId" title="{{labels.stow}}">&#x2193;</button>
      {{else}}
        <span class="slot-empty">{{labels.slotEmpty}}</span>
      {{/if}}
    </div>

    {{!-- Armor slot --}}
    <div class="myttrpg-equipment-slot{{#if system.equippedArmor}} equipped{{/if}}">
      <span class="slot-label">{{labels.armorSlot}}</span>
      {{#if system.equippedArmor}}
        <span class="slot-item-name">{{system.equippedArmor.name}}</span>
        <button type="button" class="myttrpg-btn-icon stow-btn" data-slot="equippedArmorId" title="{{labels.stow}}">&#x2193;</button>
      {{else}}
        <span class="slot-empty">{{labels.slotEmpty}}</span>
      {{/if}}
    </div>

    {{!-- Shield Generator slot --}}
    <div class="myttrpg-equipment-slot{{#if system.equippedShield}} equipped{{/if}}">
      <span class="slot-label">{{labels.shieldGeneratorSlot}}</span>
      {{#if system.equippedShield}}
        <span class="slot-item-name">{{system.equippedShield.name}}</span>
        <button type="button" class="myttrpg-btn-icon stow-btn" data-slot="equippedShieldId" title="{{labels.stow}}">&#x2193;</button>
      {{else}}
        <span class="slot-empty">{{labels.slotEmpty}}</span>
      {{/if}}
    </div>
  </section>

  {{!-- Inventory --}}
  <section class="myttrpg-section">
    <h2>{{labels.sectionInventory}}</h2>
    <div class="myttrpg-inventory">
      {{#if system.inventoryItems.length}}
        {{#each system.inventoryItems}}
        <div class="myttrpg-inventory-item">
          <span class="inv-item-name">{{name}}</span>
          <span class="inv-item-type">{{typeName}}</span>
          {{#if showHealth}}
            <span class="inv-item-health">{{healthValue}} / {{healthMax}}</span>
          {{/if}}
          {{#if canEquip}}
            <button type="button" class="myttrpg-btn-icon equip-item-btn" data-item-id="{{id}}" title="{{../labels.equip}}">&#x2191;</button>
          {{else}}
            <span class="pool-btn-spacer"></span>
          {{/if}}
          <button type="button" class="myttrpg-btn-icon delete-item-btn" data-item-id="{{id}}" title="{{../labels.deleteItem}}">&#x2715;</button>
        </div>
        {{/each}}
      {{/if}}
      <p class="inv-drop-hint">{{labels.inventoryEmpty}}</p>
    </div>
  </section>

  {{!-- Attributes --}}
  <section class="myttrpg-section">
    <h2>{{labels.sectionAttributes}}</h2>
    <div class="myttrpg-attributes">
      <div class="myttrpg-attribute">
        <label>{{labels.strength}}</label>
        <input type="number" name="system.attributes.strength" value="{{system.attributes.strength}}" min="1" max="20">
      </div>
      <div class="myttrpg-attribute">
        <label>{{labels.agility}}</label>
        <input type="number" name="system.attributes.agility" value="{{system.attributes.agility}}" min="1" max="20">
      </div>
      <div class="myttrpg-attribute">
        <label>{{labels.intellect}}</label>
        <input type="number" name="system.attributes.intellect" value="{{system.attributes.intellect}}" min="1" max="20">
      </div>
    </div>
  </section>

  {{!-- Biography --}}
  <section class="myttrpg-section">
    <h2>{{labels.sectionBiography}}</h2>
    <textarea name="system.biography" rows="4">{{system.biography}}</textarea>
  </section>

  {{/if}}

  {{!-- NPC-only fields --}}
  {{#if isNPC}}
  <section class="myttrpg-section myttrpg-inline">
    <label>{{labels.cr}}</label>
    <input type="number" name="system.cr" value="{{system.cr}}" min="0">
  </section>

  <section class="myttrpg-section">
    <h2>{{labels.sectionNotes}}</h2>
    <textarea name="system.notes" rows="6">{{system.notes}}</textarea>
  </section>
  {{/if}}

</form>
